# arb-bot 运行配置。复制成 .env 后按需修改；CLI 与看板都会读它。
#
# 标记：
#   [必填]     要用这项功能就必须填，不填则该功能不可用
#   [条件必填] 只在开启对应功能时必须填
#   [选填]     有默认值，不填也能跑
#
# 只看行情 / 只打开看板：第一、三节都可以不填。
# 密钥只放本机这份文件，不要提交、不要发给任何人。交易所 API 不要开提现权限。

# =============================================================================
# 一、必填 / 条件必填
# =============================================================================

# --- 看板下单（纸面或实盘）---
# [必填] 看板交易令牌，至少 16 字符。不配 = 交易接口全关，页面只能看榜、不能下单。
# 页面右上角「令牌」填同一个值。生成：openssl rand -hex 24
# ARB_WEB_TOKEN=

# --- 实盘（看板 ARB_WEB_LIVE 与 arb-live 共用下面的场所密钥）---
# [选填] off（默认，不连账户）/ readonly（只连接、对账、出计划）/ trade（真实下单）
# 开着实盘时看板独占各家订单意图日志：arb-live 不能同时连同一批账户。
# ARB_WEB_LIVE=off
#
# [条件必填] ARB_WEB_LIVE=trade 时必须填。平仓 / 回滚 / 减仓的价格保护，
# 小数（0.003 = 0.3%），上限 0.05。
# ARB_WEB_MARKET_SLIPPAGE=0.003
#
# [条件必填] 实盘至少配齐两家场所的密钥（见第三节）。
# [条件必填] 用 Lighter 或 Lighter RH 时必须给官方签名库的绝对路径（v1.0.10）。
# https://github.com/elliottech/lighter-go/releases/download/v1.0.10/lighter-signer-linux-amd64.so
# ARB_LIGHTER_SIGNER_LIB=/opt/lighter/lighter-signer-linux-amd64.so



# =============================================================================
# 二、条件必填 — Telegram / 告警推送
# =============================================================================
# 不配也能跑，只是不推送、没有 Telegram 菜单。Telegram 与 Discord 可单独或同时开。
# 会推：规则平仓 / 失败、外部平仓、裸敞口、对账连续不一致、盈亏核算、实盘开平仓、
# 服务启动、上次异常崩掉、价差偏离提醒。同类消息 30 分钟内只发一次，每分钟最多 6 条。
# 消息里不含地址 / 账户号 / 密钥。

# [条件必填] Telegram 两项必须同时填，只填一项不会发。
# 创建机器人找 @BotFather → /newbot；chat id：给机器人发一句话后访问
# https://api.telegram.org/bot<TOKEN>/getUpdates 看 chat.id。
# ARB_ALERT_TELEGRAM_TOKEN=
# ARB_ALERT_TELEGRAM_CHAT=

# [选填] 配了上面两项后，机器人同时提供菜单（/menu /status /positions /daily /balance /top /verify /mute /pause）。
# 只有「私聊、且用户 ID 等于管理员 ID」才会被处理，别人和群里的一律忽略。
# 管理员 ID 默认取 ARB_ALERT_TELEGRAM_CHAT（私聊的 chat id 就是你的用户 ID）；
# 那一项是群 / 频道（负数）时必须另配你自己的用户 ID。
# ARB_TELEGRAM_ADMIN_ID=
# [选填] 只要告警、不要菜单命令：
# ARB_TELEGRAM_COMMANDS=off
# [选填] 默认 https://api.telegram.org ；国内访问不了官方接口时可改代理根地址。
# ARB_TELEGRAM_API_BASE=

# [选填] Discord：频道里「编辑频道 → 整合 → webhook → 新建」，把 URL 贴到这里。
# ARB_ALERT_DISCORD_WEBHOOK=

# =============================================================================
# 三、选填 — 扫描与通用（都有默认值）
# =============================================================================

# [选填] 场所白名单，逗号分隔。不填 = 全部 15 家。拼错的名字会直接报错，不会静默跳过。
# lighter-rh 按出口 IP 限频且额度很紧：同一台机器上有实盘程序在用 api.rh.lighter.xyz 时，
# 把它排除在外，否则看板的轮询会和实盘抢同一份额度。
# ARB_VENUES=arcus,aster,binance,bitget,bybit,gate,hyperliquid,hyperliquid-io,hyperliquid-xyz,lighter,mexc,okx,ourbit,variational

# [选填] 单边吃单费率的回落值。交易所报了真实费率时用真实的；
# 只有拿不到费率的场所（Binance / OKX / Bybit / Aster / Hyperliquid / Variational）用它。
ARB_FEE_PER_SIDE=0.0005

# [选填] 计划持有天数。一次往返的 4 笔手续费摊到这些天上。
# 取 1 天会把一次性成本当成每日成本。回测在 7 天口径下最优。
ARB_AMORTIZE_DAYS=7

# [选填] 价差套利的计划持有天数（预期基差收敛要多久）。只影响年化折算。
ARB_SPREAD_HOLD_DAYS=3

# [选填] 不利入场基差的上限（%）。进场时空腿比多腿便宜超过这个数就不推荐。
# 填 off 关闭门槛。
ARB_MAX_ENTRY_BASIS_PCT=0.5

# [选填] 两腿各自的逐仓杠杆（1 ~ 100）。只影响强平距离与保证金年化，不影响排名。
ARB_LEVERAGE=3

# [选填] 执行层闸门。单笔最大名义（USDT）；off = 不设上限。
ARB_MAX_POSITION_USDT=1000
# [选填] 单日最大亏损（USDT）。
ARB_MAX_DAILY_LOSS_USDT=100

# [选填] 一个合约至少要几家场所才进入排名。
ARB_MIN_VENUES=2

# [选填] 行情 HTTP 超时（秒）。
ARB_HTTP_TIMEOUT_SEC=15

# [选填] 看板监听地址和端口。默认只听本机。对外暴露前自己加鉴权。
ARB_BIND_HOST=127.0.0.1
ARB_HTTP_PORT=8080

# [选填] 发给交易所和告警的 User-Agent。不填 = arb-bot/<版本>。
# 只含英文、数字和空格等可见字符，最长 128。改完要重启才生效。
# ARB_USER_AGENT=

# [选填] 仅去交易所走代理（行情、下单、查账户）。Telegram/Discord 仍走本机。
# HTTP：http://用户名:密码@地址:端口
# SOCKS5（推荐 socks5h，域名由代理解析）：socks5h://用户名:密码@地址:端口
# ARB_HTTP_PROXY=socks5h://user:pass@203.0.113.10:6014

# [选填] 后台快照刷新间隔（秒）。扫太勤会触发交易所限频。
ARB_SCAN_INTERVAL_SEC=60

# [选填] 日志过滤（tracing EnvFilter）。日志写 stderr。
ARB_LOG=info

# [选填] 优雅停机等待秒数（1 ~ 300）。改了 systemd 的 TimeoutStopSec 要同步。
# ARB_SHUTDOWN_GRACE_SEC=120

# [选填] 开仓要求资金费方向稳定。off 关闭这项闸门。
# ARB_REQUIRE_STABLE_FUNDING=on

# =============================================================================
# 四、条件必填 — 实盘场所密钥（用哪家填哪家）
# =============================================================================
# ARB_LIVE_VENUES 留空或 auto（默认）= 按凭据自动识别：填齐了哪几家就连哪几家（至少两家；
# Hyperliquid 钥匙齐全时主站与 HIP-3 的 xyz / io 一起连上）。也可以显式列出，如 hyperliquid,lighter。
# Ourbit、Variational 不支持实盘。请用专用账户与专用 API key。
# [选填]
# ARB_LIVE_VENUES=auto

# --- Hyperliquid（主 dex 与 hyperliquid-xyz / hyperliquid-io 共用）---
# [条件必填] 用这家时两项都要填
# ARB_HL_PRIVATE_KEY=
# ARB_HL_ACCOUNT_ADDRESS=

# --- Lighter 主网 ---
# [条件必填] 用这家时三项都要填，并填第一节的 ARB_LIGHTER_SIGNER_LIB
# ARB_LIGHTER_ACCOUNT_INDEX=
# ARB_LIGHTER_API_KEY_INDEX=
# ARB_LIGHTER_API_PRIVATE_KEY=

# --- Lighter RH（Robinhood Chain）---
# [条件必填] 用这家时三项都要填，并填第一节的 ARB_LIGHTER_SIGNER_LIB
# ARB_LIGHTER_RH_ACCOUNT_INDEX=
# ARB_LIGHTER_RH_API_KEY_INDEX=
# ARB_LIGHTER_RH_API_PRIVATE_KEY=

# --- CEX（账户须为单向持仓；其它前提见 README「实盘执行」）---
# [条件必填] 用哪家填哪家
# ARB_BINANCE_API_KEY=
# ARB_BINANCE_API_SECRET=
# ARB_BYBIT_API_KEY=
# ARB_BYBIT_API_SECRET=
# ARB_OKX_API_KEY=
# ARB_OKX_API_SECRET=
# ARB_OKX_PASSPHRASE=
# ARB_BITGET_API_KEY=
# ARB_BITGET_API_SECRET=
# ARB_BITGET_PASSPHRASE=
# ARB_GATE_API_KEY=
# ARB_GATE_API_SECRET=
# ARB_MEXC_API_KEY=
# ARB_MEXC_API_SECRET=

# --- Aster v3（API 钱包）---
# [条件必填] 用这家时三项都要填
# ARB_ASTER_USER=
# ARB_ASTER_SIGNER=
# ARB_ASTER_SIGNER_PRIVATE_KEY=

# --- Arcus（永续目前白名单内测）---
# [条件必填] 用这家时地址与 API Signing Key 必填；子账户序号默认 0
# 在 app.arcus.xyz/api-keys 用钱包生成 API key，复制只显示一次的「API Signing Key」。
# 钱包私钥不需要。
# ARB_ARCUS_ADDRESS=
# ARB_ARCUS_ACCOUNT_INDEX=0
# ARB_ARCUS_API_PRIVATE_KEY=

# =============================================================================
# 五、选填 — 看板、价差监控、路径
# =============================================================================

# --- 看板 ---
# [选填] 纸面台账的规则由看板后台每隔多少秒执行一轮。0 = 不执行（用 arb-paper --watch，两者别同时跑）。
# ARB_WEB_PAPER_WATCH_SEC=0
# [选填] 策略页后台预检记住的参数文件。
# ARB_PRECHECK_STATE=arb-precheck-watches.json
# [选填] 运行标记（检测异常崩掉）。优雅停机后标干净，崩溃 / 强杀会在下次启动补推告警。
# ARB_WEB_RUN_STATE=arb-web.run.json
# [选填] 实盘持仓规则由看板后台每隔多少秒执行一轮（默认同 ARB_SCAN_INTERVAL_SEC）。0 = 不自动执行。
# ARB_WEB_LIVE_WATCH_SEC=60
# [选填] 纸面台账路径。
# ARB_LEDGER=arb-ledger.jsonl
# [选填] 实盘台账与订单意图日志目录。
# ARB_LIVE_LEDGER=arb-live-ledger.jsonl
# ARB_LIVE_JOURNAL_DIR=.


# --- 价差监控 ---
# [选填] off 关闭监控。
# ARB_RH_SPREAD=on
# [选填] 估算用的单笔名义（USDT）。
# ARB_RH_SPREAD_SIZE=2000
# [选填] 提醒门槛：回到正常水平的预估净收益（%）。
# ARB_RH_SPREAD_ALERT_PCT=0.05
# [选填] on = 只看股票、指数、商品，不看加密币。
# ARB_RH_SPREAD_EQUITIES_ONLY=off
# [选填] 分钟历史目录（相对工作目录）；自动交易设置也存在这里。
# ARB_RH_SPREAD_DIR=rh-spread
# [选填] 监控哪几组，`场所A:场所B` 逗号分隔。不填 = 按已识别的实盘场所两两组合。
# ARB_RH_SPREAD_PAIRS=arcus:lighter-rh
# [选填] Entropy（hyperliquid-io）自返佣，小数：Tier 4 = 2（200%）。
# ARB_ENTROPY_SELF_REBATE=0

# --- 价差自动交易 ---
# [选填] 两笔自动开仓之间至少隔多少秒。不填 = 60。0 = 开完立刻看下一笔。
# 只影响价差自动交易，手动开仓不受限。上限 3600。
# ARB_RH_AUTO_OPEN_GAP_SEC=60

# ---价差手动交易---
# [选填]手动交易总开关。默认关闭。只有 on 才走手动筛选、预检、推送和开仓。
ARB_MANUAL_TRADE=off

# [选填] 手动交易「回到正常净收益」门槛（%）。默认 0.05。
# 只影响之后写入的手动机会；不参与排名，也不改自动交易的门槛。改完要重启。
# ARB_MANUAL_MIN_NET_PCT=0.05

# [选填] 手动机会进入预检的「回到正常净收益」门槛（%）。
# 不写则与 ARB_MANUAL_MIN_NET_PCT 相同。只挡预检和推送，不改写入机会文件的门槛。改完要重启。
# ARB_MANUAL_PRECHECK_MIN_NET_PCT=0.05

# [选填] 可开仓机会的旁路记录。默认写到当前目录的 opportunity-log.jsonl。
# 只追加，不参与开仓。删掉文件不影响运行。填 off 关闭。
# ARB_OPPORTUNITY_LOG=opportunity-log.jsonl

